# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# Required for the "Ask" chat assistant. Create a key at https://openrouter.ai/settings/keys
# Server-only: read by the /api/chat route handler. Do NOT rename it with a NEXT_PUBLIC_
# prefix, which would inline the key into the browser bundle.
OPENROUTER_API_KEY=

# Optional. Your deployed site URL, sent to OpenRouter as HTTP-Referer for app attribution.
# Leave empty to send no attribution headers.
OPENROUTER_SITE_URL=
